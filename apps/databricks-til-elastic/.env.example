# Kopier til .env: cp .env.example .env
# Standardverdiene peker på det lokale docker compose-miljøet, så
# `docker compose up -d` + `bun start` fungerer uten videre oppsett.
#
# Bun laster .env automatisk. I produksjon settes disse som vanlige
# miljøvariabler i stedet.

DATABASE_URL=postgresql://postgres:dev@localhost:5433/matrikkelenadresse
ES_URL=https://matrikkelen-adrs-dev-cf782b.es.europe-north1.gcp.elastic-cloud.com
ES_API_KEY=1234
DATABRICKS_MOCK=true

# Datoer fra Postgres tolkes som UTC. Jobben nekter å starte i annen sone.
TZ=UTC

# Lesbar logg i stedet for JSON. Settes ikke i produksjon.
LOG_PRETTY=true
